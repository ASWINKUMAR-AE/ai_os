{
  "name": "ai-desktop-assistant",
  "version": "1.0.0",
  "description": "A Jarvis-like AI desktop assistant with voice control, automation, and chat",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "electron",
    "ai",
    "assistant",
    "voice",
    "automation",
    "chatgpt"
  ],
  "author": "AI Assistant",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "docx": "^9.6.1",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "node-record-lpcm16": "^1.0.1",
    "pptxgenjs": "^4.0.1",
    "speech-to-text": "^2.4.1"
  },
  "build": {
    "appId": "com.ai.assistant",
    "productName": "AI Desktop Assistant",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "modules/**/*",
      "utils/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
